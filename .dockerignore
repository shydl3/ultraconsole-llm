backend/.venv
backend/venv
backend/.env
backend/.webhook.json

# 运行时数据与模型权重（由卷挂载）
models
backend/models
data
Rules/data
Rules/tests
tmp

# 交付构建产物
deliverable/dist
deliverable/package/models
deliverable/package/data

# 前端依赖与旧构建
frontend/node_modules
frontend/dist

