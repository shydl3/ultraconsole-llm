ULTRA_API_TOKEN=change-me
ULTRA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ULTRA_MAX_UPLOAD_BYTES=20971520
ULTRA_MAX_IMAGE_PIXELS=25000000
ULTRA_MAX_WS_BASE64_CHARS=16777216
ULTRA_MAX_TRACKER_CONTEXTS=10
# 默认只加载 YOLO11 pose；如需其他模型，把文件放进 backend/models 后改这里。
ULTRA_DEFAULT_MODEL=yolo11m-pose.pt
# Set only when a trusted webhook endpoint intentionally runs on the private network.
ULTRA_ALLOW_PRIVATE_WEBHOOKS=false

# 语义分析（可选）：默认使用后端当前 Python；若 Qwen 跑在独立环境中则指向该环境的解释器。
# 外部挂载/独立环境由环境变量注入，不要写死本机绝对路径到代码里。
# VLM_PYTHON=/path/to/qwen-env/bin/python
# VLM_MODEL_PATH=/path/to/Qwen3-VL-2B-Instruct
# VLM_MODEL_ROOT=/path/to/models          # 权重发现根目录（外部挂载时覆盖）
# VLM_DATA_ROOT=/path/to/vlm-data
# 单条视频上传限制：默认 128 GiB / 48 小时（0 表示不限制），12–24h 长录像直接可分析。
# VLM_MAX_UPLOAD_BYTES=137438953472
# VLM_MAX_DURATION_SEC=172800
# 长录像的回放代理默认只对 12h 以内视频生成，避免数十 GB 转码与显存/磁盘占用。
# VLM_PLAYBACK_MAX_DURATION_SEC=43200
