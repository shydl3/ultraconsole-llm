# UltraConsole 运行配置。修改后重新双击「启动.bat」生效。
ULTRACONSOLE_IMAGE=ultraconsole
ULTRACONSOLE_TAG=__TAG__
ULTRACONSOLE_PORT=8001
TZ=Asia/Shanghai

# 依赖下载源。国内网络慢可换成镜像，例如：
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   HF_ENDPOINT=https://hf-mirror.com
PIP_INDEX_URL=https://pypi.org/simple
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
TORCH_SPEC=torch torchvision
TORCH_VERSION=
HF_ENDPOINT=https://huggingface.co

# 默认语义模型（首次安装时下载到 models/）
# 换 4B 时这两项要一起改：repo 决定下载内容，path 决定加载目录。
VLM_MODEL_REPO=Qwen/Qwen3-VL-2B-Instruct
VLM_MODEL_PATH=/models/Qwen3-VL-2B-Instruct

# 离线安装：把 wheel 文件放进 offline/ 并设为 1
PIP_NO_INDEX=0
# 已有权重（手动拷贝）时可设为 1 跳过下载
SKIP_MODEL_DOWNLOAD=0

# 启用鉴权时需要重新构建镜像（前端 token 在构建期注入），默认留空。
# ULTRA_API_TOKEN=
