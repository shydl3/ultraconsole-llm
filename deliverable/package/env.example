# UltraConsole 运行配置。修改后重新双击「启动.bat」生效。
ULTRACONSOLE_IMAGE=ultraconsole
ULTRACONSOLE_TAG=__TAG__
ULTRACONSOLE_PORT=8001
TZ=Asia/Shanghai

# 依赖下载源：默认全部为大陆可直连地址；海外部署可改回官方源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 留空 = torch 直接从上面的 PyPI 镜像安装（Linux wheel 自带 CUDA 依赖）。
# 仅在需要固定 PyTorch 官方索引时才填，例如 https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=
TORCH_SPEC=torch torchvision
TORCH_VERSION=
HF_ENDPOINT=https://hf-mirror.com

# Qwen 权重：ModelScope 为首选（大陆直连），下载失败才回退到 HF 镜像。
VLM_MODEL_SOURCE=modelscope
MODELSCOPE_ENDPOINT=https://modelscope.cn
MODELSCOPE_REVISION=master

# 默认语义模型（首次安装时下载到 models/）
# 换 4B 时这几项要一起改：repo 决定下载内容，path 决定加载目录。
VLM_MODEL_REPO=Qwen/Qwen3-VL-2B-Instruct
VLM_MODEL_PATH=/models/Qwen3-VL-2B-Instruct

# YOLO11 姿态权重随交付包内置（models/detect/yolo11m-pose.pt），不联网下载。

# 离线安装：把 wheel 文件放进 offline/ 并设为 1
PIP_NO_INDEX=0
# 已有 Qwen 权重（手动拷贝）时可设为 1 跳过下载
SKIP_MODEL_DOWNLOAD=0

# 启用鉴权时需要重新构建镜像（前端 token 在构建期注入），默认留空。
# ULTRA_API_TOKEN=
